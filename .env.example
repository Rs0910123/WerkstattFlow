# =============================================================================
# WerkstattFlow — Vorlage für Umgebungsvariablen
# =============================================================================
# So verwenden:
#   1. Diese Datei kopieren:      cp .env.example .env.local
#   2. Werte eintragen (siehe unten und README.md)
#   3. Entwicklungsserver neu starten
#
# WICHTIG: .env.local niemals in Git einchecken und niemals weitergeben.
#          Nur diese Vorlage (.env.example) gehört ins Repository.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Supabase — wird gebraucht (Anmeldung, Datenbank, Dateien)
# -----------------------------------------------------------------------------
# Wo zu finden: Supabase → Ihr Projekt → Zahnrad "Project Settings" → "API Keys"
#
# NEXT_PUBLIC_... Variablen sind öffentlich (landen im Browser). Das ist bei
# diesen beiden Werten so vorgesehen. Der "service_role"-Schlüssel unten darf
# dagegen NIEMALS mit NEXT_PUBLIC_ beginnen.
NEXT_PUBLIC_SUPABASE_URL=https://ihr-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ihr-anon-public-key

# Nur serverseitig. Wird aktuell noch nicht benutzt, ist aber für spätere
# Verwaltungsaufgaben (z. B. Einladungen, Aufräumen) vorgesehen.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 2. Eigene Adressen
# -----------------------------------------------------------------------------
# Name der Plattform in der Oberfläche. Ohne Wert: "WerkstattFlow".
NEXT_PUBLIC_APP_NAME=WerkstattFlow

# Basis-Adresse der Anwendung — wird für die Links in E-Mails gebraucht.
# Lokal:  http://localhost:3000    Auf Vercel: Ihre echte Adresse.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 3. Resend — E-Mail-Versand (Baustein 4, hier noch nicht benutzt)
# -----------------------------------------------------------------------------
# Wo zu finden: resend.com → "API Keys" → "Create API Key"
RESEND_API_KEY=

# Absenderadresse der E-Mails. Die Domain muss bei Resend verifiziert sein.
# Beispiel: WerkstattFlow <benachrichtigung@ihre-domain.de>
EMAIL_FROM=


# -----------------------------------------------------------------------------
# 4. Twilio — SMS (Baustein 4, hier noch nicht benutzt)
# -----------------------------------------------------------------------------
# Wo zu finden: twilio.com → Console → Account Info / Phone Numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Absenderrufnummer im Format +49..., z. B. +4930123456789
TWILIO_FROM_NUMBER=

# Zufällige Zeichenkette, mit der eingehende Twilio-Webhooks geprüft werden
# (Schutz davor, dass Fremde SMS-Anfragen auslösen). Frei erfinden, z. B.
# mit: openssl rand -hex 24
TWILIO_WEBHOOK_SECRET=
